rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(myUid())).data.role;
    }

    // deactivated staff lose access right away
    function isStaff() {
      return isSignedIn() &&
        myRole() in ["admin", "branch_manager", "technical_staff", "sales_staff"] &&
        get(/databases/$(database)/documents/users/$(myUid())).data.get("accountStatus", "active") != "deactivated";
    }

    // branch manager or old admin role, still active
    function isManager() {
      return isStaff() && myRole() in ["admin", "branch_manager"];
    }

    // staff except sales staff, who only use pos and the catalog
    function isOpsStaff() {
      return isStaff() && myRole() != "sales_staff";
    }

    // ---- users ----
    match /users/{uid} {
      // your own doc, or any doc if staff
      allow read: if isSignedIn() && myUid() == uid;
      allow read: if isOpsStaff();

      // customer sign-up starts with no store credit
      allow create: if isSignedIn() && myUid() == uid &&
        request.resource.data.role == "customer" &&
        request.resource.data.get("creditBalance", 0) == 0;

      // branch manager making a staff account
      allow create: if isManager() &&
        request.resource.data.role in ["admin", "branch_manager", "technical_staff", "sales_staff"];

      // own doc updates cant change role or status or raise store credit or take it below zero
      allow update: if isSignedIn() && myUid() == uid &&
        request.resource.data.get("role", null) == resource.data.get("role", null) &&
        request.resource.data.get("accountStatus", null) == resource.data.get("accountStatus", null) &&
        request.resource.data.get("creditBalance", 0) <= resource.data.get("creditBalance", 0) &&
        request.resource.data.get("creditBalance", 0) >= 0;

      // staff management is branch manager only
      allow update: if isManager();
      // other staff only touch customer accounts so nobody can raise their own role
      allow update: if isOpsStaff() &&
        resource.data.get("role", "") == "customer" &&
        request.resource.data.get("role", "") == "customer";

      allow delete: if false;
    }

    // ---- catalog ----
    // only branch manager sets prices, others add products without prices
    function isPriceManager() {
      return isManager();
    }

    // sales staff can only view the catalog
    function isProductEditor() {
      return isStaff() && myRole() != "sales_staff";
    }

    function priceFieldsUnchanged() {
      return request.resource.data.get("costingPrice", 0) == resource.data.get("costingPrice", 0) &&
        request.resource.data.get("retailPrice", 0) == resource.data.get("retailPrice", 0) &&
        request.resource.data.get("wholesalePrice", 0) == resource.data.get("wholesalePrice", 0) &&
        request.resource.data.get("priceLocked", false) == resource.data.get("priceLocked", false) &&
        request.resource.data.get("pricePending", false) == resource.data.get("pricePending", false);
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isPriceManager();
      allow create: if isProductEditor() &&
        request.resource.data.get("costingPrice", 0) == 0 &&
        request.resource.data.get("retailPrice", 0) == 0 &&
        request.resource.data.get("wholesalePrice", 0) == 0 &&
        request.resource.data.get("pricePending", false) == true &&
        request.resource.data.get("status", "") == "inactive";

      allow update: if isPriceManager();
      allow update: if isProductEditor() && priceFieldsUnchanged() &&
        !(request.resource.data.get("pricePending", false) == true &&
          request.resource.data.get("status", "") == "active");

      allow delete: if isProductEditor();
    }

    // cost and wholesale prices kept out of the public product docs
    match /productPrices/{productId} {
      allow read: if isStaff();
      allow create, update: if isPriceManager() &&
        request.resource.data.keys().hasOnly(["costingPrice", "wholesalePrice", "updatedAt"]);
      allow delete: if isProductEditor();
    }

    // store banner, public read, set by branch manager or technical staff
    match /storeSettings/{settingId} {
      allow read: if true;
      // never deleted, just turned off
      allow create, update: if isStaff() && myRole() in ["admin", "branch_manager", "technical_staff"];
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOpsStaff();
    }

    // ---- retail orders ----
    // photos must be from our own cloudinary, empty is fine
    function photoLinkOk(data, field) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].matches("https://res[.]cloudinary[.]com/wb6wxped/.+"));
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.customerId == myUid();
      allow read: if isOpsStaff();

      // credit used cant be more than the balance and must come off in the same write
      allow create: if isSignedIn() &&
        request.resource.data.customerId == myUid() &&
        request.resource.data.status == "placed" &&
        request.resource.data.get("total", 0) >= 0 &&
        !request.resource.data.keys().hasAny(["paymentIssue", "invoiceNo", "unappliedCredit", "paymentOverage", "verification", "closedReason"]) &&
        photoLinkOk(request.resource.data, "proofOfPaymentUrl") &&
        photoLinkOk(request.resource.data, "prescriptionPhotoUrl") &&
        (request.resource.data.get("creditApplied", 0) == 0 ||
         (request.resource.data.creditApplied > 0 &&
          getAfter(/databases/$(database)/documents/users/$(myUid())).data.get("lastCreditOrderId", null) == orderId &&
          getAfter(/databases/$(database)/documents/users/$(myUid())).data.get("creditBalance", 0) ==
            get(/databases/$(database)/documents/users/$(myUid())).data.get("creditBalance", 0) - request.resource.data.creditApplied));

      // customers can only confirm receipt, auto-deliver after 3 days, or resubmit a hold fix
      allow update: if isSignedIn() && resource.data.customerId == myUid() && (
        (resource.data.status == "delivered" &&
         request.resource.data.status == "received" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "statusTimestamps"]))
        ||
        (resource.data.status == "dispatched" &&
         request.resource.data.status == "delivered" &&
         resource.data.statusTimestamps.dispatched < request.time - duration.value(3, "d") &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "statusTimestamps"]))
        ||
        (resource.data.get("paymentIssue", null) != null &&
         request.resource.data.get("paymentIssue", null) != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["proofOfPaymentUrl", "paymentReferenceNumber", "paymentIssue", "prescriptionPhotoUrl"]) &&
         // only the replaced photo is checked
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["proofOfPaymentUrl"]) ||
          photoLinkOk(request.resource.data, "proofOfPaymentUrl")) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["prescriptionPhotoUrl"]) ||
          photoLinkOk(request.resource.data, "prescriptionPhotoUrl")) &&
         // customer can only mark the hold resolved
         request.resource.data.paymentIssue.diff(resource.data.paymentIssue).affectedKeys()
           .hasOnly(["resolvedByCustomerAt", "holdUntil"]) &&
         (!("holdUntil" in request.resource.data.paymentIssue) ||
          request.resource.data.paymentIssue.holdUntil == resource.data.paymentIssue.get("holdUntil", null)))
      );
      allow update: if isOpsStaff();

      allow delete: if false;
    }

    // ---- prescription pre-orders ----
    // not used anymore, kept for old records
    match /prescriptionOrders/{orderId} {
      allow read: if isSignedIn() && resource.data.customerId == myUid();
      allow read: if isOpsStaff();

      allow update: if isOpsStaff();
      allow delete: if false;
    }

    // ---- customer notifications ----
    // only staff write these, customers can read theirs and mark read
    match /customerNotifications/{notifId} {
      allow read: if isOpsStaff();
      allow read: if isSignedIn() && resource.data.customerId == myUid();

      allow create: if isOpsStaff();
      // customers own order placed notice from checkout
      allow create: if isSignedIn() &&
        request.resource.data.customerId == myUid() &&
        request.resource.data.kind == "order_placed" &&
        request.resource.data.read == false &&
        request.resource.data.keys().hasOnly(["customerId", "title", "detail", "link", "severity", "read", "createdAt", "kind"]);

      allow update: if isSignedIn() && resource.data.customerId == myUid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow update: if isOpsStaff();

      allow delete: if false;
    }

    // ---- staff-only operational data ----
    // stock batches are public read since the shop needs real stock
    match /stockBatches/{batchId} {
      allow read: if true;
      allow update: if isStaff();
      allow create, delete: if isOpsStaff();
    }
    // batch unit costs kept out of the public stock docs
    match /batchCosts/{batchId} {
      allow read, create, update: if isOpsStaff();
    }
    match /posSales/{saleId} {
      allow read, create: if isStaff();
      allow update: if isOpsStaff();
    }
    match /suppliers/{supplierId}      { allow read, write: if isOpsStaff(); }
    match /purchaseOrders/{poId}       { allow read, create, update: if isOpsStaff(); }
    match /reconciliations/{reconId}   { allow read, create, update: if isOpsStaff(); }
    match /writeOffs/{writeOffId}      { allow read, create, update: if isOpsStaff(); }
    match /wholesaleAccounts/{acctId}  { allow read, write: if isOpsStaff(); }
    match /wholesaleOrders/{orderId}   { allow read, create, update: if isOpsStaff(); }
    match /wholesaleExchanges/{exchangeId} { allow read, create, update: if isOpsStaff(); }

    // ---- audit log (append-only) ----
    match /auditLog/{entryId} {
      allow read: if isOpsStaff();
      // each staff role logs its own actions
      allow create: if isStaff();
      // customers only log confirming receipt and auto-deliver
      allow create: if isSignedIn() &&
        request.resource.data.action in ["Order Received by Customer", "Order Auto-Delivered"] &&
        request.resource.data.keys().hasOnly(["action", "details", "user", "ipAddress", "createdAt"]) &&
        request.resource.data.details is string && request.resource.data.details.size() <= 200 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notifId} { allow read, write: if isOpsStaff(); }

    // ---- live chat ----
    // customers use cust_<uid>, guests use a random id
    function chatThreadTextOk() {
      return request.resource.data.get("lastMessage", "") is string &&
        request.resource.data.get("lastMessage", "").size() <= 200 &&
        request.resource.data.get("customerName", "") is string &&
        request.resource.data.get("customerName", "").size() <= 100 &&
        request.resource.data.get("handoffReason", "") is string &&
        request.resource.data.get("handoffReason", "").size() <= 100;
    }

    function chatThreadIsMine(threadId) {
      return threadId.matches("guest_[A-Za-z0-9]{24}") ||
        (isSignedIn() && threadId == "cust_" + myUid());
    }

    match /chatThreads/{threadId} {
      allow get: if isOpsStaff() || chatThreadIsMine(threadId);
      allow list, update: if isOpsStaff();
      // only the chat fields with short strings so nobody can spam the db
      allow create: if chatThreadIsMine(threadId) &&
        request.resource.data.status == "ai" &&
        (request.resource.data.customerId == null || (isSignedIn() && request.resource.data.customerId == myUid())) &&
        request.resource.data.keys().hasOnly(["lastMessage", "lastMessageAt", "customerName", "kind", "customerId", "status", "unreadByStaff", "createdAt"]) &&
        chatThreadTextOk();
      // customers can only switch between assistant and waiting for staff
      allow update: if chatThreadIsMine(threadId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastMessageAt", "customerName", "status", "unreadByStaff", "handoffReason", "handoffAt"]) &&
        request.resource.data.status in ["ai", "waiting_staff", resource.data.status] &&
        (resource.data.status != "staff" || request.resource.data.status == "staff") &&
        chatThreadTextOk();

      match /messages/{messageId} {
        allow read: if isOpsStaff() || chatThreadIsMine(threadId);
        allow create: if isOpsStaff() ||
          (chatThreadIsMine(threadId) &&
           request.resource.data.sender in ["customer", "assistant", "system"] &&
           request.resource.data.text is string &&
           request.resource.data.text.size() <= 2000 &&
           request.resource.data.keys().hasOnly(["sender", "text", "createdAt", "cards"]) &&
           (!("cards" in request.resource.data) ||
            (request.resource.data.cards is list && request.resource.data.cards.size() <= 20)));
        allow update, delete: if false;
      }
    }

    // one ai reply counter per day, only goes up by one
    match /chatUsage/{day} {
      allow read: if true;
      allow create: if request.resource.data.count == 1 &&
        request.resource.data.keys().hasOnly(["count", "updatedAt"]);
      allow update: if request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.keys().hasOnly(["count", "updatedAt"]);
    }

    // ---- shared counters ----
    // customers only bump the order number counter, the rest is staff-only
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // no deleting counters or numbering restarts
      allow create, update: if isStaff() && counterId != "salesInvoices";
      // invoice numbers only ever go up by one
      allow create: if isStaff() && counterId == "salesInvoices" &&
        request.resource.data.count == 1;
      allow update: if isStaff() && counterId == "salesInvoices" &&
        request.resource.data.count == resource.data.count + 1;
      // order number counter only goes up by one
      allow create: if isSignedIn() && counterId.matches("orders-[0-9]{4}") &&
        request.resource.data.count == 1;
      allow update: if isSignedIn() && counterId.matches("orders-[0-9]{4}") &&
        request.resource.data.count == resource.data.count + 1;
    }

    // ---- temporary: clearing test data before go-live ----
    // branch manager can delete what clear-test-data.html clears, turns off on the date below, remove after go-live
    function canClearTestData() {
      return isStaff() && myRole() in ["admin", "branch_manager"] &&
        request.time < timestamp.date(2026, 11, 15);
    }
    match /{collectionId}/{docId} {
      allow delete: if canClearTestData() && collectionId in [
        "orders", "prescriptionOrders", "posSales", "wholesaleOrders", "wholesaleExchanges",
        "customerNotifications", "stockBatches", "purchaseOrders", "reconciliations", "writeOffs",
        "chatThreads", "notifications", "auditLog", "loginAttempts",
        "products", "categories", "suppliers", "wholesaleAccounts", "productPrices", "batchCosts"];
    }
    match /chatThreads/{threadId}/messages/{messageId} {
      allow delete: if canClearTestData();
    }
    match /users/{uid} {
      allow delete: if canClearTestData() && uid != myUid() &&
        !(resource.data.get("role", "") in ["admin", "branch_manager"]);
    }
    match /counters/{counterId} {
      // the go-live start number for invoices
      allow create, update: if canClearTestData() && counterId == "salesInvoices";
      allow delete: if canClearTestData() &&
        (counterId.matches("(orders|purchaseOrders|reconciliations)-[0-9]{4}") || counterId in ["wholesaleExchanges", "products"]);
    }

    // ---- login lockout tracking ----
    // used before sign-in, only staff can list since doc names are emails
    function loginLockValid() {
      return !("lockedUntil" in request.resource.data) ||
        (request.resource.data.lockedUntil is number &&
         request.resource.data.lockedUntil <= request.time.toMillis() + 3 * 60 * 1000);
    }
    match /loginAttempts/{email} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(["count", "lockedUntil"]) &&
        request.resource.data.count == 1 &&
        loginLockValid();
      allow update: if request.resource.data.keys().hasOnly(["count", "lockedUntil"]) &&
        request.resource.data.count is int &&
        request.resource.data.count == resource.data.get("count", 0) + 1 &&
        request.resource.data.count <= 1000 &&
        resource.data.get("lockedUntil", 0) <= request.time.toMillis() &&
        loginLockValid();
      allow delete: if (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email) ||
        (resource != null && resource.data.get("lockedUntil", 0) > 0 &&
         resource.data.get("lockedUntil", 0) <= request.time.toMillis()) ||
        isManager();
      allow list: if isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
